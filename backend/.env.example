# Backend Environment Variables
PROJECT_NAME="College ERP System"
API_V1_STR="/api/v1"

# Database Configuration (Neon PostgreSQL)
# Example: postgresql+psycopg://user:password@ep-cool-name.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/college_erp

# Security & JWT Auth
SECRET_KEY=dev_secret_key_change_in_production_32bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Settings (Comma-separated origins)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
